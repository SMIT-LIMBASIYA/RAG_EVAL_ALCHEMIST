# API Keys (Configure Groq for free fast LLM generation)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 1. LLM Generation Settings
# Options: 'groq', 'openai', 'gemini'
LLM_PROVIDER=groq
LLM_MODEL_NAME=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0

# 2. Embedding Settings (Local & Cloud Options)
# Options: 'local' (Free & Offline), 'openai', 'gemini', 'chroma_default'
EMBEDDING_PROVIDER=local
# Local models: 'BAAI/bge-small-en-v1.5', 'all-MiniLM-L6-v2', 'all-mpnet-base-v2'
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# 3. Chunking & Retrieval Parameters
DOCUMENT_PATH=./data/achemist.txt
CHUNK_SIZE=550
CHUNK_OVERLAP=120
TOP_K=4
RETRIEVAL_METRIC=cosine

# 4. Vector Store Settings (ChromaDB)
VECTOR_STORE_TYPE=chroma_local
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=alchemist_knowledge_base
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=

# 5. Evaluation Thresholds (0.0 to 1.0)
RETRIEVAL_RECALL_THRESHOLD=0.70
RETRIEVAL_PRECISION_THRESHOLD=0.70
FAITHFULNESS_THRESHOLD=0.60
ANSWER_RELEVANCY_THRESHOLD=0.60
CONTEXT_RELEVANCY_THRESHOLD=0.70

# Evaluation Judge Model (When OpenAI key is active)
EVAL_JUDGE_MODEL=gpt-4o-mini

# 6. Dataset Paths & Reporting
GOLDEN_RETRIEVAL_PATH=./data/golden_retrieval.json
GOLDEN_GENERATOR_PATH=./data/golden_generator.json
GOLDEN_PIPELINE_PATH=./data/golden_rag_pipeline.json
ANALYSIS_OUTPUT_DIR=./analyses
LOG_LEVEL=INFO
